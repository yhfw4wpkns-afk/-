<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>マイ総合ポータルサイト</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-800 min-h-screen flex flex-col">

    <!-- ヘッダー -->
    <header class="bg-white shadow-sm sticky top-0 z-20">
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
            <h1 class="text-xl font-bold text-blue-600">マイポータルサイト</h1>
            
            <!-- タブ切り替えボタン -->
            <div class="flex gap-2 bg-gray-100 p-1 rounded-lg">
                <button onclick="switchTab('search')" id="tab-search" class="px-4 py-2 text-sm font-medium rounded-md bg-white shadow-sm text-blue-600 transition-all">サイト内検索</button>
                <button onclick="switchTab('google')" id="tab-google" class="px-4 py-2 text-sm font-medium rounded-md text-gray-600 hover:text-blue-600 transition-all">Google検索</button>
                <button onclick="switchTab('game')" id="tab-game" class="px-4 py-2 text-sm font-medium rounded-md text-gray-600 hover:text-blue-600 transition-all">ミニゲーム</button>
            </div>
        </div>
    </header>

    <!-- メインコンテンツエリア -->
    <main class="max-w-6xl mx-auto px-4 py-8 flex-grow w-full">
        
        <!-- ① サイト内検索タブ -->
        <section id="section-search" class="space-y-6">
            <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
                <form onsubmit="return false;">
                    <input 
                        type="text" 
                        id="searchInput" 
                        placeholder="サイト内の記事をキーワード検索..." 
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                        oninput="filterItems()"
                    >
                </form>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="md:col-span-2">
                    <h2 class="text-lg font-semibold mb-4 text-gray-700">記事一覧</h2>
                    <div id="itemList" class="space-y-4"></div>
                    <p id="noResult" class="hidden text-gray-500 text-center py-8">該当する記事が見つかりませんでした。</p>
                </div>
                <div class="md:col-span-1">
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 sticky top-24">
                        <h2 class="text-lg font-semibold mb-4 text-gray-700 border-b pb-2">詳細情報</h2>
                        <div id="detailView">
                            <p class="text-gray-400 text-sm">リストから項目をクリックするとここに詳細が表示されます。</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ② Google検索タブ -->
        <section id="section-google" class="hidden space-y-6">
            <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200 text-center max-w-2xl mx-auto">
                <h2 class="text-2xl font-bold text-gray-800 mb-2">Google 検索</h2>
                <p class="text-gray-500 text-sm mb-6">このサイトからそのままGoogleでウェブ全体を検索できます。</p>
                
                <!-- Google公式の検索フォーム -->
                <form action="https://www.google.com/search" method="get" target="_blank" class="flex gap-2">
                    <input 
                        type="text" 
                        name="q" 
                        placeholder="Googleで検索するワードを入力..." 
                        class="flex-grow px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                        required
                    >
                    <button type="submit" class="px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-all text-sm">検索</button>
                </form>
            </div>
        </section>

        <!-- ③ ミニゲームタブ（クリック連打ゲーム） -->
        <section id="section-game" class="hidden space-y-6">
            <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200 text-center max-w-md mx-auto space-y-4">
                <h2 class="text-xl font-bold text-gray-800">🎮 ミニゲーム（連打アタック！）</h2>
                <p class="text-gray-500 text-sm">制限時間10秒間で何回ボタンを押せるかな？</p>
                
                <div class="text-4xl font-extrabold text-blue-600 my-4" id="scoreDisplay">スコア: 0</div>
                <div class="text-lg font-bold text-red-500" id="timerDisplay">残り時間: 10秒</div>

                <div class="flex justify-center gap-4">
                    <button id="gameButton" onclick="clickCount()" disabled class="px-6 py-4 bg-gray-300 text-gray-600 font-bold rounded-xl shadow transition-all text-lg cursor-not-allowed">
                        スタート前
                    </button>
                    <button onclick="startGame()" id="startBtn" class="px-6 py-4 bg-green-500 text-white font-bold rounded-xl shadow hover:bg-green-600 transition-all text-lg">
                        ゲームスタート！
                    </button>
                </div>
            </div>
        </section>

    </main>

    <!-- フッター -->
    <footer class="bg-white border-t border-gray-200 py-4 text-center text-xs text-gray-400">
        &copy; 2026 マイポータルサイト
    </footer>

    <!-- JavaScript 制御 -->
    <script>
        // タブ切り替え機能
        function switchTab(tabName) {
            document.getElementById('section-search').classList.add('hidden');
            document.getElementById('section-google').classList.add('hidden');
            document.getElementById('section-game').classList.add('hidden');

            document.getElementById('tab-search').className = "px-4 py-2 text-sm font-medium rounded-md text-gray-600 hover:text-blue-600 transition-all";
            document.getElementById('tab-google').className = "px-4 py-2 text-sm font-medium rounded-md text-gray-600 hover:text-blue-600 transition-all";
            document.getElementById('tab-game').className = "px-4 py-2 text-sm font-medium rounded-md text-gray-600 hover:text-blue-600 transition-all";

            document.getElementById('section-' + tabName).classList.remove('hidden');
            document.getElementById('tab-' + tabName).className = "px-4 py-2 text-sm font-medium rounded-md bg-white shadow-sm text-blue-600 transition-all";
        }

        // サイト内検索データ
        const items = [
            { id: 1, title: "HTMLの基本構造", category: "プログラミング", content: "Webページの骨組みを作るための言語です。タグを使って文字や画像を表示します。" },
            { id: 2, title: "Google検索機能の仕組み", category: "便利機能", content: "このサイトのGoogle検索タブから、別タブで簡単にGoogleの全ウェブ検索が開けます。" },
            { id: 3, title: "ミニゲームで遊ぼう", category: "ゲーム", content: "連打ゲームやちょっとした暇つぶし要素を同じページ内に組み込んでいます。" },
            { id: 4, title: "GitHub Pagesでの公開", category: "ホスティング", content: "作成したHTMLファイルをGitHubに保存するだけで、無料で世界中に公開できます。" }
        ];

        window.addEventListener('DOMContentLoaded', () => {
            renderList(items);
        });

        function renderList(data) {
            const listContainer = document.getElementById('itemList');
            const noResult = document.getElementById('noResult');
            listContainer.innerHTML = '';

            if (data.length === 0) {
                noResult.classList.remove('hidden');
                return;
            } else {
                noResult.classList.add('hidden');
            }

            data.forEach(item => {
                const card = document.createElement('div');
                card.className = "bg-white p-5 rounded-xl shadow-sm border border-gray-200 hover:border-blue-400 cursor-pointer transition-all";
                card.innerHTML = `
                    <span class="inline-block px-2.5 py-1 bg-blue-50 text-blue-600 text-xs font-medium rounded-full mb-2">${item.category}</span>
                    <h3 class="font-bold text-gray-800 text-lg mb-1">${item.title}</h3>
                    <p class="text-gray-500 text-sm line-clamp-2">${item.content}</p>
                `;
                card.addEventListener('click', () => {
                    showDetail(item);
                });
                listContainer.appendChild(card);
            });
        }

        function filterItems() {
            const keyword = document.getElementById('searchInput').value.toLowerCase();
            const filtered = items.filter(item => 
                item.title.toLowerCase().includes(keyword) || 
                item.content.toLowerCase().includes(keyword) ||
                item.category.toLowerCase().includes(keyword)
            );
            renderList(filtered);
        }

        function showDetail(item) {
            const detailView = document.getElementById('detailView');
            detailView.innerHTML = `
                <span class="inline-block px-2.5 py-1 bg-blue-50 text-blue-600 text-xs font-medium rounded-full mb-2">${item.category}</span>
                <h3 class="font-bold text-gray-800 text-xl mb-3">${item.title}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">${item.content}</p>
            `;
        }

        // ミニゲームのロジック
        let score = 0;
        let timeLeft = 10;
        let gameTimer = null;
        let isPlaying = false;

        function startGame() {
            score = 0;
            timeLeft = 10;
            isPlaying = true;
            document.getElementById('scoreDisplay').innerText = "スコア: " + score;
            document.getElementById('timerDisplay').innerText = "残り時間: " + timeLeft + "秒";
            
            const btn = document.getElementById('gameButton');
            btn.disabled = false;
            btn.className = "px-6 py-4 bg-blue-600 text-white font-bold rounded-xl shadow hover:bg-blue-700 active:scale-95 transition-all text-lg cursor-pointer";
            btn.innerText = "連打しろ！";

            document.getElementById('startBtn').classList.add('hidden');

            gameTimer = setInterval(() => {
                timeLeft--;
                document.getElementById('timerDisplay').innerText = "残り時間: " + timeLeft + "秒";
                if (timeLeft <= 0) {
                    clearInterval(gameTimer);
                    isPlaying = false;
                    btn.disabled = true;
                    btn.className = "px-6 py-4 bg-gray-300 text-gray-600 font-bold rounded-xl shadow transition-all text-lg cursor-not-allowed";
                    btn.innerText = "終了！";
                    document.getElementById('startBtn').classList.remove('hidden');
                    document.getElementById('startBtn').innerText = "もう一度遊ぶ";
                }
            }, 1000);
        }

        function clickCount() {
            if (!isPlaying) return;
            score++;
            document.getElementById('scoreDisplay').innerText = "スコア: " + score;
        }
    </script>
</body>
</html>
