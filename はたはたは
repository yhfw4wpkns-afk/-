<!DOCTYPE html>

<html lang="ja">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1">

<title>My Search</title>

<style>

body {

  margin: 0;

  background: #101827;

  color: white;

  font-family: Arial, sans-serif;

}

header {

  padding: 24px 16px;

  text-align: center;

}

h1 { color: #60a5fa; }

form {

  display: flex;

  gap: 8px;

  max-width: 600px;

  margin: auto;

  padding: 12px;

}

input {

  flex: 1;

  min-width: 0;

  padding: 14px;

  border-radius: 10px;

  border: 1px solid #44516a;

  background: #263449;

  color: white;

}

button {

  padding: 14px;

  border: 0;

  border-radius: 10px;

  background: #3b82f6;

  color: white;

}

#results {

  max-width: 600px;

  margin: 20px auto;

  padding: 16px;

}

.card {

  background: #202d41;

  padding: 16px;

  border-radius: 12px;

  margin-bottom: 12px;

}

</style>

</head>

<body>

<header>

  <h1>My Search</h1>

  <p>ページ内検索デモ</p>

  <form id="form">

    <input id="q" placeholder="検索ワード..." required>

    <button>検索</button>

  </form>

</header>

<main id="results">

  <div class="card">

    キーワードを入力して検索してみよう！

  </div>

</main>

<script>

const items = [

  {

    title: "地球について",

    description: "地球の自然や環境について学ぼう。",

    keywords: "地球 自然 環境 理科"

  },

  {

    title: "宇宙について",

    description: "惑星や星、太陽系について学ぼう。",

    keywords: "宇宙 星 惑星 太陽系"

  },

  {

    title: "歴史について",

    description: "日本や世界の歴史を調べよう。",

    keywords: "歴史 日本 世界 社会"

  }

];

document.getElementById("form").onsubmit = function(e) {

  e.preventDefault();

  const q = document.getElementById("q")

    .value.trim().toLowerCase();

  const found = items.filter(item =>

    (item.title + item.description + item.keywords)

      .toLowerCase().includes(q)

  );

  const results = document.getElementById("results");

  results.replaceChildren();

  if (!found.length) {

    results.textContent =

      "一致する結果がありません。別の言葉で検索してね。";

    return;

  }

  found.forEach(item => {

    const card = document.createElement("div");

    card.className = "card";

    const title = document.createElement("h2");

    title.textContent = item.title;

    const desc = document.createElement("p");

    desc.textContent = item.description;

    card.append(title, desc);

    results.append(card);

  });

};

</script>

</body>

</html>
