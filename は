
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nova Browser</title>
<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  background: #0b1020;
  color: white;
  font-family: Arial, sans-serif;
}

header {
  padding: 24px 14px;
  text-align: center;
}

h1 {
  color: #60a5fa;
  font-size: 32px;
}

form {
  display: flex;
  gap: 8px;
  max-width: 800px;
  margin: 12px auto;
}

input {
  flex: 1;
  min-width: 0;
  padding: 14px;
  border-radius: 12px;
  border: 1px solid #40506c;
  background: #182238;
  color: white;
  font-size: 16px;
}

button {
  padding: 12px 16px;
  border: 0;
  border-radius: 12px;
  background: #3b82f6;
  color: white;
  font-size: 15px;
}

#message {
  color: #aab6ce;
  font-size: 13px;
  max-width: 800px;
  margin: 10px auto;
}

#browser {
  width: 100%;
  height: 70vh;
  min-height: 400px;
  border: 1px solid #34415e;
  border-radius: 12px;
  background: white;
}

main { padding: 0 12px 20px; }

@media(max-width: 480px) {
  form { gap: 5px; }
  button { padding: 12px 10px; }
}
</style>
</head>
<body>

<header>
  <h1>Nova Browser</h1>
  <p>URLを入力してページを開こう</p>

  <form id="urlForm">
    <input
      id="urlInput"
      type="text"
      placeholder="https://example.com"
      autocomplete="url"
      autocapitalize="none"
      spellcheck="false"
      required
    >
    <button type="submit">開く</button>
  </form>

  <div id="message">
    サイトによってはページ内表示に対応していません。
  </div>
</header>

<main>
  <iframe
    id="browser"
    title="ページ表示"
    referrerpolicy="no-referrer"
    src="about:blank"
    allowfullscreen
  ></iframe>
</main>

<script>
const form = document.getElementById("urlForm");
const input = document.getElementById("urlInput");
const frame = document.getElementById("browser");
const message = document.getElementById("message");

form.addEventListener("submit", function(event) {
  event.preventDefault();

  let value = input.value.trim();

  if (!value) return;

  if (!/^https?:\/\//i.test(value)) {
    value = "https://" + value;
  }

  let url;

  try {
    url = new URL(value);
  } catch {
    message.textContent = "URLを確認してください。";
    return;
  }

  if (url.protocol !== "https:" &&
      url.protocol !== "http:") {
    message.textContent = "HTTPまたはHTTPSのURLを入力してください。";
    return;
  }

  frame.src = url.href;
  message.textContent =
    "ページを読み込んでいます。表示できないサイトもあります。";
});
</script>

</body>
</html>
